# F1 Dashboard Proxy - Environment Variables

# Server port (optional, defaults to 4000)
PORT=4000

# Proxy mode: "live-polling" | "mqtt" | "openf1" | "replay" | "signalr" | "auto"
# live-polling: Polls OpenF1 REST API (free, no credentials)
# mqtt / openf1: OpenF1 paid tier via MQTT (requires OPENF1_USERNAME + OPENF1_PASSWORD)
# replay:       Uses locally recorded data for testing
# signalr:      F1 official live timing as the SOLE source (no OpenF1). Needs
#               F1_LIVETIMING_TOKEN. GPS/telemetry require a paid F1 TV plan.
# auto:         replay by default → upgrades to MQTT automatically when a live session is detected
PROXY_MODE=auto

# OpenF1 API Credentials for live data via MQTT
# Get credentials at: https://openf1.org/auth.html
# Without these, the proxy will use replay mode
OPENF1_USERNAME=your_email@example.com
OPENF1_PASSWORD=your_password

# Replay session (only used when PROXY_MODE=replay)
# Any OpenF1 session_key — find them at https://api.openf1.org/v1/sessions
# Defaults to Azerbaijan GP 2024 (session_key=9598) if not set
# REPLAY_SESSION_KEY=9598

# F1 official live timing (SignalR Core) — powers live mini-sectors, sector
# times, session clock and qualifying knockout. OPTIONAL: without it the
# dashboard still works on OpenF1/MQTT, just shows a "degraded" banner.
#
# Since 2025 F1 gated this feed behind auth. Pin a token extracted from your
# browser: log in at formula1.com (F1 TV account), open DevTools → Network,
# filter "signalrcore", and copy the `authToken` query value from the request.
# The token expires after ~4 days — re-grab it when the proxy logs "Negotiate
# 401". (Automating the login is blocked by F1's Imperva bot protection — WIP.)
# F1_LIVETIMING_TOKEN=your_jwt_here


# ── Team radio transcription (OpenAI speech-to-text) ─────────────────────────
# With a key set, every radio clip is transcribed once and cached in SQLite
# (radio_transcripts), so replays and restarts are free. Without a key the
# dashboard just shows the clips with no caption.
# OPENAI_API_KEY=sk-...
# STT model. Default gpt-transcribe (~$0.0045/min): the current recommended
# one, and the only one that takes `keywords`, which is what primes driver
# names and pit jargon on noisy clips. gpt-4o-mini-transcribe (~$0.003/min)
# and gpt-4o-transcribe still work but are deprecated upstream.
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Model used to translate + split speakers (chat completions, JSON mode).
# OPENAI_TRANSLATE_MODEL=gpt-4o-mini
# Language of the audio. Team radio is conducted in English, and saying so
# stops the model from occasionally deciding a noisy clip is Welsh. Widen the
# list (comma separated) if a driver's radios come through in another
# language — pinned to "en", those come back as an English approximation of
# what they said instead of their own words.
# OPENAI_TRANSCRIBE_LANGUAGES=en
# Set to false to turn transcription off without removing the key.
# RADIO_TRANSCRIBE=true
